# Optional render service configuration. Defaults shown below.
RENDER_SERVICE_URL=http://127.0.0.1:3200
# Set the same private key on Next and the render service; required in production.
RENDER_API_TOKEN=
RENDER_PORT=3200
RENDER_HOST=127.0.0.1
RENDER_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional absolute Chrome/Chromium executable path. Otherwise Remotion finds/downloads one.
# REMOTION_BROWSER_EXECUTABLE=
