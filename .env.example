# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
FIRECRAWL_API_KEY=
AI_GATEWAY_API_KEY=
# Any structured-output-capable model on Vercel AI Gateway:
AI_MODEL=anthropic/claude-sonnet-5.5
# Without AI Gateway, server AI falls back to OpenAI with a cheap model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Exa powers product research (/api/research, research before /api/generate, MCP research_product).
# Without Firecrawl, product pages are also read with Exa (og:image as the product shot).
EXA_API_KEY=
# Fast jobs (copy, chat edits, research summaries) run on Cerebras when set.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
# Optional: where research briefs are cached for 24h (default .data/research).
# RESEARCH_DATA_DIR=
