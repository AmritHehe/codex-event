# Set on both Next and the standalone render service.
BLOB_READ_WRITE_TOKEN=
# Trusted Firecrawl image storage hosts (exact hostname or trusted provider suffix).
SCREENSHOT_ASSET_HOSTS=storage.googleapis.com,firecrawl.dev,supabase.co
# Next-only; point to the render service on your private network.
RENDER_SERVICE_URL=http://127.0.0.1:3200
